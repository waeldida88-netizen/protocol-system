generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name_ar   String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("user")
  status    String   @default("active")
}

model Leader {
  id             String   @id @default(uuid())
  name_ar        String
  job_ar         String
  entity_ar      String
  phone          String?
  email          String?
}

model Event {
  id            String   @id @default(uuid())
  title_ar      String
  venue_ar      String
  date          DateTime
  time          String
  type          String
  backgroundImg String?
  layoutData    String?  // هنا بنخزن شكل القاعة كامل
   latitude      Float?  // خط العرض
  longitude     Float?  // خط الطول
  invitations   Invitation[]
}

model Guest {
  id           String   @id @default(uuid())
  name_ar      String
  job_ar       String
  entity_ar    String
  phone        String?
  email        String?
  rsvp_status  String   @default("pending")
  invitations  Invitation[]
}

model Invitation {
  id          String   @id @default(uuid())
  event_id    String
  event       Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  guest_id    String
  guest       Guest    @relation(fields: [guest_id], references: [id])
  seat_info   String?  // معلومات الكرسي
  custom_text String?  // النص المخصص للدعوة
  qr_code     String?  @unique // اللي هيتبعت في الـ QR
  is_scanned  Boolean  @default(false)
  createdAt   DateTime @default(now())
}model Template {
  id          String   @id @default(uuid())
  name_ar     String   // اسم القالب (مثلاً: مسرح 50 كرسي)
  type        String   // theater, round, blank
  layoutData  String   // هنا هنخزن شكل القاعة كاملة (JSON)
  createdAt   DateTime @default(now())
}